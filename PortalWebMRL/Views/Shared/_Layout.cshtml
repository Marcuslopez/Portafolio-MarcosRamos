<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PortalWebMRL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PortalWebMRL.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
</head>
<body>
    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PortalWebMRL</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Account/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Cliente">Clientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Products">Productos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Orders">Órdenes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Orders/Create">Nueva Orden</a>
                        </li>   
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Notifications">Notificaciones</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PortalWebMRL - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
   

    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!-- 1) Bootstrap bundle (para toasts) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- 2) Socket.IO client -->
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>


<script>
    const socket = io("http://localhost:4000");

    socket.on("connect", () => {
      console.log("Conectado a RealtimeServiceNode:", socket.id);
    });

    socket.on("event", (evt) => {
      console.log("EVENTO RECIBIDO:", evt);
     //const actor = evt.data?.actor || null;      
    const notif = {
      type: evt.type || "event",
      message: evt.message || "Evento recibido",
      severity: (evt.data && evt.data.severity) ? evt.data.severity : "info",
      entity: (evt.data && evt.data.entity) ? evt.data.entity : null,
      entityId: (evt.data && evt.data.entityId) ? evt.data.entityId : null,
      actor : evt.data?.actor || null,
      data: evt.data || {},     
      createdAt: new Date().toISOString()
      
    };

      saveNotification(notif);
      showToast(notif.message,notif.severity);
    });

    function saveNotification(notif) {
      const key = "notifications";
      const list = JSON.parse(localStorage.getItem(key) || "[]");

      list.unshift(notif);
      localStorage.setItem(key, JSON.stringify(list.slice(0, 100)));
    }

    function showToast(message, severity) {
      const cls = severity === "success" ? "text-bg-success"
                : severity === "info" ? "text-bg-info"
                : severity === "warning" ? "text-bg-warning"
                : severity === "error" ? "text-bg-danger"
                : "text-bg-primary";
                
      const container = document.getElementById("toastContainer");
      if (!container) return;

      const id = "toast_" + Date.now();

      container.insertAdjacentHTML("beforeend", `
        <div id="${id}" class="toast align-items-center ${cls} border-0 mb-2">
          <div class="d-flex">
            <div class="toast-body">${message}</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
          </div>
        </div>
      `);

      const toastEl = document.getElementById(id);
      new bootstrap.Toast(toastEl, { delay: 3000 }).show();
    }
</script>