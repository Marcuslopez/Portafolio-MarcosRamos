@model PortalWebMRL.Models.OrdenDetailsViewModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detalle de Orden</h2>
        <a class="btn btn-outline-secondary" href="/Orders">Volver</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>IdOrden:</strong> @Model.IdOrden</div>
                    <div class="col-md-5"><strong>Cliente:</strong> @Model.ClienteNombre (ID: @Model.IdCliente)</div>
                    <div class="col-md-4"><strong>Fecha:</strong> @Model.FechaOrden</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Estado:</strong> @Model.Estado</div>
                    <div class="col-md-3"><strong>Total:</strong> $@Model.Total</div>
                </div>
            </div>
        </div>

        <h5>Items</h5>

        <table class="table table-striped table-bordered" id="detalleTable">
            <thead>
                <tr>
                    <th>ID Producto</th>
                    <th>Nombre Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unit.</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>@d.IdProducto</td>
                        <td>@d.ProductoNombre</td>
                        <td>@d.Cantidad</td>
                        <td>@d.PrecioUnitario</td>
                        <td>@d.Subtotal</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#detalleTable').DataTable({
                paging: false,
                searching: false,
                info: false,
                language: {
                    emptyTable: "Sin detalles para mostrar"
                }
            });
        });
    </script>
}
